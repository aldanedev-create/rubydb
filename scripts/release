#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "rbconfig"
require "rubygems"

root = File.expand_path("..", __dir__)
Dir.chdir(root)

abort "release metadata preflight failed" unless system(RbConfig.ruby, File.join(root, "scripts", "release_check"))
abort "Go accelerator build failed" unless system(RbConfig.ruby, File.join(root, "scripts", "build_accelerator"))

release_descriptors = [
  "rubydb.gemspec",
  "adapters/activerecord/rubydb-activerecord.gemspec",
  "packaging/homebrew/rubydb.rb"
]
untracked_runtime_files = `git ls-files --others --exclude-standard -- lib exe accelerator rubydb.gemspec`.lines.map(&:chomp)
unless untracked_runtime_files.empty?
  abort "Runtime files are untracked and would be omitted from the gem: #{untracked_runtime_files.join(", ")}. Commit them before publishing."
end

placeholder_pattern = /yourusername|your name|you@example\.com|your\.email@example\.com/i
placeholder_files = release_descriptors.select do |path|
  File.exist?(path) && File.read(path).match?(placeholder_pattern)
end
unless placeholder_files.empty?
  abort "Release metadata contains placeholders in: #{placeholder_files.join(", ")}. Set the real owner, contact, homepage, source, and changelog URLs before publishing."
end
abort "rake build:checksum failed" unless system("rake", "build:checksum")

if ENV["RUBYDB_GEM_SIGNING_KEY"] || ENV["RUBYDB_GEM_CERT"]
  abort "Both RUBYDB_GEM_SIGNING_KEY and RUBYDB_GEM_CERT are required for gem signing" unless ENV["RUBYDB_GEM_SIGNING_KEY"] && ENV["RUBYDB_GEM_CERT"]
  abort "RubyGems signing key does not exist" unless File.file?(ENV["RUBYDB_GEM_SIGNING_KEY"])
  abort "RubyGems signing certificate does not exist" unless File.file?(ENV["RUBYDB_GEM_CERT"])
end

gem_path = Dir["pkg/rubydb-*.gem"].max_by { |path| File.mtime(path) }
abort "No built gem found" unless gem_path
checksum_path = File.join("checksums", "#{File.basename(gem_path)}.sha512")
expected = File.read(checksum_path).split.first
actual = Digest::SHA512.file(gem_path).hexdigest
abort "Checksum verification failed" unless expected == actual

# Build the ActiveRecord adapter alongside the core release. Its version is
# intentionally independent so Rails applications can pin the adapter while
# remaining on the RubyDB 0.1.x compatibility line.
adapter_dir = File.join(root, "adapters", "activerecord")
adapter_spec = Dir.chdir(adapter_dir) { Gem::Specification.load("rubydb-activerecord.gemspec") }
abort "Unable to load ActiveRecord adapter gemspec" unless adapter_spec
adapter_pkg_dir = File.join(adapter_dir, "pkg")
FileUtils.mkdir_p(adapter_pkg_dir)
adapter_gem_path = File.join(adapter_pkg_dir, "rubydb-activerecord-#{adapter_spec.version}.gem")
abort "ActiveRecord adapter gem build failed" unless system(
  "gem", "build", "-V", "rubydb-activerecord.gemspec", "--output", adapter_gem_path,
  chdir: adapter_dir
)
adapter_checksum_dir = File.join(root, "checksums")
FileUtils.mkdir_p(adapter_checksum_dir)
adapter_checksum_path = File.join(adapter_checksum_dir, "#{File.basename(adapter_gem_path)}.sha512")
adapter_expected = Digest::SHA512.file(adapter_gem_path).hexdigest
File.write(adapter_checksum_path, "#{adapter_expected}  #{File.basename(adapter_gem_path)}\n")
abort "ActiveRecord adapter checksum verification failed" unless
  Digest::SHA512.file(adapter_gem_path).hexdigest == File.read(adapter_checksum_path).split.first
puts "Adapter #{adapter_spec.name} #{adapter_spec.version} built to #{adapter_gem_path}."
puts "Adapter checksum written to #{adapter_checksum_path}"

if ENV["RUBYDB_PUBLISH"] == "1"
  puts "RubyGems 2FA/OTP settings: https://rubygems.org/profile/edit"
  puts "If prompted for an OTP, enter the current code from your authenticator."
  api_key = ENV.fetch("GEM_HOST_API_KEY", "")
  credentials_path = Gem.configuration.credentials_path
  credentials_available = File.file?(credentials_path) && !File.zero?(credentials_path)
  abort "Set GEM_HOST_API_KEY or configure RubyGems credentials at #{credentials_path}" if api_key.empty? && !credentials_available
  abort "gem push failed for #{gem_path}" unless system("gem", "push", gem_path)
  puts "Published #{gem_path}"
  if ENV["RUBYDB_PUBLISH_ADAPTER"] == "1"
    abort "gem push failed for #{adapter_gem_path}" unless system("gem", "push", adapter_gem_path)
    puts "Published #{adapter_gem_path}"
  else
    puts "Adapter built but not published. Set RUBYDB_PUBLISH_ADAPTER=1 only for a new adapter version."
  end
else
  puts "Release artifact verified: #{gem_path}"
  puts "Release artifact verified: #{adapter_gem_path}"
  puts "To publish core: RUBYDB_PUBLISH=1 GEM_HOST_API_KEY=<RubyGems API key> ruby scripts/release"
  puts "To publish a new adapter version too: RUBYDB_PUBLISH=1 RUBYDB_PUBLISH_ADAPTER=1 GEM_HOST_API_KEY=<RubyGems API key> ruby scripts/release"
end
