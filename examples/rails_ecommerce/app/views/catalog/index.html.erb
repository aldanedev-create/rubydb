<h1>RubyDB Commerce Benchmark</h1>
<p>Catalog reads, grouped counts, eager loading, and order transactions use ActiveRecord.</p>

<p>
  <% @categories.each do |category, count| %>
    <%= link_to "#{category} (#{count})", products_path(category: category) %>
  <% end %>
</p>

<h2>Products</h2>
<ul>
  <% @products.each do |product| %>
    <li>
      <strong><%= product.name %></strong>
      — <%= product.category %>
      — $<%= format("%.2f", product.price_cents / 100.0) %>
      — <%= product.stock %> in stock
      <%= form_with url: orders_path, scope: :order, method: :post, local: true do |form| %>
        <%= form.hidden_field :product_id, value: product.id %>
        <%= form.hidden_field :name, value: "Demo Customer" %>
        <%= form.hidden_field :email, value: "demo@example.test" %>
        <%= form.number_field :quantity, value: 1, min: 1, max: product.stock %>
        <%= form.submit "Buy" %>
      <% end %>
    </li>
  <% end %>
</ul>

<h2>Featured inventory</h2>
<ul>
  <% @featured.each do |product| %>
    <li><%= product.name %> (<%= product.stock %> units)</li>
  <% end %>
</ul>
